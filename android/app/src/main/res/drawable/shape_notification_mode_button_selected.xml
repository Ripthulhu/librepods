<!-- Currently active listening-mode button in the device notification. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#4D8A8A8A" />
            <corners android:radius="14dp" />
            <padding android:left="4dp" android:top="8dp" android:right="4dp" android:bottom="8dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#338A8A8A" />
            <corners android:radius="14dp" />
            <padding android:left="4dp" android:top="8dp" android:right="4dp" android:bottom="8dp" />
        </shape>
    </item>
</selector>
